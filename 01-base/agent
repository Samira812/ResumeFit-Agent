import asyncio
from claude_agent_sdk import (
    AssistantMessage, ClaudeAgentOptions, Textblock, query)


tools_instructions = open("02-tools/tool_instructions.txt").read()

context_instructions = open("03-context/context_instructions.txt").read()

guardrails = open("04-guardrails/guardrails.txt").read()

scoring_agent_instructions = open("05-subagents/scoring_agent.txt").read()

rewriting_agent_instructions = open("05-subagents/rewriting_agent.txt").read()

job_description_text = """
<PLACEHOLDER: job description will be inserted here>
"""

TASK = f"""
{tools_instructions}

{context_instructions}

{guardrails}

SCORING AGENT INSTRUCTIONS:
{scoring_agent_instructions}

REWRITING AGENT INSTRUCTIONS:
{rewriting_agent_instructions}

Job Description Text (if provided):
{job_description_text}

You are a resume-fitting agent. The job description is provided above. You will be given a user's CV file. Your task is to analyze the job description may be provided as:
1. Plain text (job_description_text)
2. A file uploaded by the user.

Your job is to:
1. Read the user's CV file.
2. Detect whether a job description file exists.
3. If a file exists, read it.
4. If no file exists, use the job_description_text.
5. Extract keywords and requirements from the job description.
6. Compare them with the user's CV.
7. Calculate a percentage match and return it to the user.
When scoring is needed:
- Create a subagent named "scoring_agent".
- Pass cv_text and job_description_text to it.
- Wait for the scoring_agent to return JSON scoring data.
- Use this data in the rewriting_agent.
8. Generate a customized resume using only verified CV content.
9. Write the new resume into a file named according to the job title and the
    company name, e.g., "Software_Engineer_Acme_Corp_Resume.txt".
10. Convert the new resume into a PDF file named according to the job title and
    the company name, e.g.,
    "Software_Engineer_Acme_Corp_Resume.pdf".
11. Send the final resume pdf file back to the user.
"""


async def main():
    options = ClaudeAgentOptions(
        allowed_tools=[
            "agent",
            "read",
            "write",
            "grep",
            "senduserfile",
            "sendmessage",
            "list",
            "python",
        ],
        setting_source=[],
    )

    async for msg in query(prompt=TASK, options=options):
        if isinstance(msg, AssistantMessage):
            for block in msg.content:
                if isinstance(block, Textblock):
                    print(block.text)

asyncio.run(main())
